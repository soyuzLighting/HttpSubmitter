<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.herald</groupId>
    <artifactId>herald-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Herald</name>
    <description>Reliable external HTTP notification delivery service</description>

    <modules>
        <module>herald-common</module>
        <module>herald-protocol</module>
        <module>herald-storage</module>
        <module>herald-raft</module>
        <module>herald-server</module>
        <module>herald-producer</module>
        <module>herald-producer-spring-boot-starter</module>
        <module>herald-consumer</module>
        <module>herald-consumer-spring-boot-starter</module>
        <module>herald-examples</module>
    </modules>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.5.16</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 统一管理第三方依赖版本 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 内部模块 -->
            <dependency>
                <groupId>io.herald</groupId>
                <artifactId>herald-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.herald</groupId>
                <artifactId>herald-protocol</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.herald</groupId>
                <artifactId>herald-storage</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.herald</groupId>
                <artifactId>herald-raft</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.herald</groupId>
                <artifactId>herald-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.herald</groupId>
                <artifactId>herald-producer</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.herald</groupId>
                <artifactId>herald-producer-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.herald</groupId>
                <artifactId>herald-consumer</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.herald</groupId>
                <artifactId>herald-consumer-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 所有模块统一日志门面 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- 所有模块统一测试框架（JUnit 5） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
